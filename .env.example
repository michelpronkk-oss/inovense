TRIGGER_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=https://auterim.com
NEXT_PUBLIC_MARKETING_URL=https://auterim.com
NEXT_PUBLIC_APP_URL=https://app.auterim.com
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Optional outside production; production is fixed to the approved app host.
SLACK_OAUTH_REDIRECT_URI=https://app.auterim.com/api/connectors/slack/callback
SLACK_OAUTH_STATE_SECRET=
NEXT_PUBLIC_ADMIN_URL=https://admin.auterim.com
NEXT_PUBLIC_PUBLIC_HOST=www.auterim.com
NEXT_PUBLIC_PUBLIC_APEX_HOST=auterim.com
NEXT_PUBLIC_ADMIN_HOST=admin.auterim.com
NEXT_PUBLIC_APP_HOST=app.auterim.com

# Optional search ownership verification. Set values issued by the provider;
# leave blank until verified in Google Search Console / Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional IndexNow key (8-128 letters, digits, or dashes). The public
# verification endpoint is https://auterim.com/indexnow-key and only changed,
# canonical public URLs should be submitted by a release workflow.
INDEXNOW_KEY=

# OAuth callback used by the Gmail connector. Register this exact URL with Google.
GOOGLE_OAUTH_REDIRECT_URI=https://app.auterim.com/api/connectors/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=

# Gmail Push / Pub/Sub. The topic must be in the same Google Cloud project as
# the OAuth client used for the Gmail users.watch request. Push authentication
# expects a Google OIDC token minted for this service account and audience.
GOOGLE_CLOUD_PROJECT_ID=
GMAIL_PUBSUB_TOPIC=projects/PROJECT_ID/topics/auterim-gmail-inbox
GMAIL_PUBSUB_SUBSCRIPTION=projects/PROJECT_ID/subscriptions/auterim-gmail-inbox-push
GMAIL_PUBSUB_PUSH_AUDIENCE=https://app.auterim.com/api/connectors/gmail/push
GMAIL_PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=

# OAuth callback used by the Salesforce connector. Register this exact URL in
# the Salesforce External Client App. These are server-only values.
SALESFORCE_REDIRECT_URI=https://app.auterim.com/api/connectors/salesforce/callback
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_OAUTH_STATE_SECRET=

# HubSpot direct OAuth. Register this exact callback in the HubSpot app.
HUBSPOT_REDIRECT_URI=https://app.auterim.com/api/connectors/hubspot/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_OAUTH_STATE_SECRET=

# Trello confidential OAuth2 + PKCE. Register this exact callback in Atlassian.
TRELLO_REDIRECT_URI=https://app.auterim.com/api/connectors/trello/callback
TRELLO_CLIENT_ID=
TRELLO_CLIENT_SECRET=
TRELLO_OAUTH_STATE_SECRET=

# Supabase Auth and server configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Existing connector-token encryption key. Set the same existing production
# value in Vercel and Trigger.dev; never commit the secret value.
CONNECTOR_TOKEN_ENCRYPTION_KEY=

# Email delivery via Resend. Sender identities are hardcoded, verified
# auterim.com addresses (see src/lib/email/config.ts) -- not environment
# configured, so a stale value here can never silently break delivery.
# auterim.com must be verified in the Resend dashboard (SPF/DKIM/DMARC).
RESEND_API_KEY=
INTAKE_TO_EMAIL=hello@auterim.com
SUPPORT_EMAIL=support@auterim.com

# Billing configuration. Product IDs are server-only; never add a NEXT_PUBLIC_ prefix.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_FOUNDATION=
DODO_PRODUCT_WORKFORCE=
DODO_PRODUCT_SCALE=
DODO_CHECKOUT_SESSIONS_URL=https://live.dodopayments.com
DODO_CUSTOMER_PORTAL_URL=

# Trigger.dev configuration and optional public application URL.
TRIGGER_SECRET_KEY=
TRIGGER_PUBLIC_APP_URL=https://app.auterim.com

# OpenAI-generated Slack internal recommendations (src/lib/workflows/
# openai-recommendation-generator.ts). Only the Trigger.dev worker that runs
# slack-recommendation-generate needs OPENAI_API_KEY - the Next.js app never
# calls OpenAI. Missing/disabled config always falls back to the
# deterministic recommendation builder; Slack ingestion is never blocked.
OPENAI_API_KEY=
OPENAI_RECOMMENDATION_MODEL=gpt-5.6-luna
OPENAI_RECOMMENDATIONS_ENABLED=true
