TRIGGER_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=https://auterim.com
NEXT_PUBLIC_MARKETING_URL=https://auterim.com
NEXT_PUBLIC_APP_URL=https://app.auterim.com
NEXT_PUBLIC_ADMIN_URL=https://admin.auterim.com
NEXT_PUBLIC_PUBLIC_HOST=www.auterim.com
NEXT_PUBLIC_PUBLIC_APEX_HOST=auterim.com
NEXT_PUBLIC_ADMIN_HOST=admin.auterim.com
NEXT_PUBLIC_APP_HOST=app.auterim.com

# OAuth callback used by the Gmail connector. Register this exact URL with Google.
GOOGLE_OAUTH_REDIRECT_URI=https://app.auterim.com/api/connectors/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=

# OAuth callback used by the Salesforce connector. Register this exact URL in
# the Salesforce External Client App. These are server-only values.
SALESFORCE_REDIRECT_URI=https://app.auterim.com/api/connectors/salesforce/callback
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_OAUTH_STATE_SECRET=

# HubSpot direct OAuth. Register this exact callback in the HubSpot app.
HUBSPOT_REDIRECT_URI=https://app.auterim.com/api/connectors/hubspot/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_OAUTH_STATE_SECRET=

# Supabase Auth and server configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email delivery via Resend. Sender identities are hardcoded, verified
# auterim.com addresses (see src/lib/email/config.ts) -- not environment
# configured, so a stale value here can never silently break delivery.
# auterim.com must be verified in the Resend dashboard (SPF/DKIM/DMARC).
RESEND_API_KEY=
INTAKE_TO_EMAIL=hello@auterim.com
SUPPORT_EMAIL=support@auterim.com

# Billing configuration. Keep product IDs and plan values unchanged.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_STARTER=
DODO_PRODUCT_GROWTH=
# Dodo product/price identifier for the public Scale subscription.
DODO_SCALE_PRICE_ID=
DODO_PRODUCT_OPERATOR=
DODO_CHECKOUT_SESSIONS_URL=https://live.dodopayments.com
DODO_CUSTOMER_PORTAL_URL=

# Trigger.dev configuration and optional public application URL.
TRIGGER_SECRET_KEY=
TRIGGER_PUBLIC_APP_URL=https://app.auterim.com
